{
  "name": "rucola",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test:domain": "node --experimental-strip-types --test src/domain/__tests__/*.test.mjs",
    "test:crypto": "node --experimental-strip-types --test src/crypto/*.test.mjs",
    "test:cloud-client": "node --experimental-strip-types --test src/cloud/__tests__/*.test.mjs",
    "test:sync-engine": "node --experimental-strip-types --test src/sync/*.test.mjs"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.16",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "@cipherman/pake-js": "0.1.1",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "npm@11"
}
