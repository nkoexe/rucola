{
  "expo": {
    "name": "Rucola",
    "slug": "rucola",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rucola",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Rucola needs access to your photos and videos so you can send something to your person.",
          "cameraPermission": "Rucola needs camera access so you can capture something to send.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-status-bar"
    ],
    "android": {
      "package": "com.rucola.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "rucola.njco.dev",
              "pathPrefix": "/"
            }
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.rucola.app"
    }
  }
}
